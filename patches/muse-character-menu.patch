 /* ---------- Home ---------- */
 
+#ifdef MUSE_CUSTOM_CHARACTERS
+static void on_character_choose(lv_event_t *e)
+{
+    int index = (int)(intptr_t)lv_event_get_user_data(e);
+    s_character_save_failed = false;
+    if (!muse_character_select(index)) {
+        s_character_save_failed = true;
+        if (s_current == s_characters) set_text(s_character_error, "Could not save. Try again.");
+        else set_text(s_home_character, "Save failed");
+        return;
+    }
+    muse_state_poke();
+    show(s_home);
+    muse_ui_show_face();
+}
+
+static void build_character_page(lv_obj_t *tile)
+{
+    lv_obj_t *list;
+    s_characters = page(tile, "CHARACTER", true, &list);
+    int selected = muse_character_current();
+    for (int i=0; i<muse_character_count(); i++) {
+        lv_obj_t *value;
+        row(list, NULL, muse_character_name(i), &value, on_character_choose, (void *)(intptr_t)i);
+        set_text(value, i == selected ? LV_SYMBOL_OK : "");
+    }
+    s_character_error = note(list, "");
+}
+
+static const page_t CHARACTERS = { &s_characters, build_character_page };
